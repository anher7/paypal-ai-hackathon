# The backend can load these names from a root .env file. Never commit real credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
AGREE_FIRST_DATABASE_PATH=
PORT=3001


# Optional manual gateway configuration; the local connection script supplies these internally.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
MODEL_DEFAULT=claude-haiku-4-5
# Set AGREE_FIRST_AI_MODE=examples only to disable live AI for local testing.
